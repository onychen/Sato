# Node: --env-file=.env (never commit real credentials)
SATO_PROVIDER=anthropic
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
SATO_MODEL=claude-sonnet-4-5
# Optional API base URL; Anthropic appends /v1/messages, DeepSeek appends /chat/completions.
# Set it to https://api.anthropic.com for Anthropic or https://api.deepseek.com for DeepSeek.
SATO_BASE_URL=https://api.anthropic.com
